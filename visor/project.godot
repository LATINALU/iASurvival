; iASurvival — visor 3D del observador (solo dibuja lo que manda el servidor).
config_version=5

[application]

config/name="iASurvival — Observador"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icono.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
